# Copy into .env in the project root. Never commit .env.
DASHBOARD_PASSWORD=replace-with-your-own-dashboard-password
DASHBOARD_HOST=127.0.0.1
PORT=4174
DASHBOARD_DATA=.local-dashboard/data.json
COOKIE_SECURE=false
# Optional iPhone Shortcuts receiver. Use a private random key of at least 32 characters.
# Leave blank to disable POST /api/notes/import. See docs/apple-notes.md.
NOTES_SYNC_TOKEN=
# Optional read-only Home Assistant connection, server-side only:
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
TESLA_BATTERY_ENTITY=
TESLA_STATUS_ENTITY=
TESLA_TARGET_ENTITY=
TESLA_POWER_ENTITY=
TESLA_ENERGY_ENTITY=
TESLA_REMAINING_ENTITY=
CHARGER_STATUS_ENTITY=
